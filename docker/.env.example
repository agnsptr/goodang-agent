# Docker Compose — copy to docker/.env (never commit .env)
# Used by docker/docker-compose.fase1.yml (Temporal worker stack)

TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=change-me-local-dev

# Supabase Project #1 — worker only (NOT for ADK; see root .env.example)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# Telegram — required by goodang-temporal-worker in docker-compose
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional overrides (see docker-compose.fase1.yml)
# TEMPORAL_ADDRESS=127.0.0.1:7233
