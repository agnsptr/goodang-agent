# Goodang Agent — copy to .env (never commit .env)
# See docs/13. GOODANG_INFRASTRUCTURE_SPEC.md §7

# --- Supabase (Project #1: goodang-app) — ADK uses anon key only ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Worker service_role: configure in docker/.env (see docker/.env.example)

# --- Temporal (client from ADK / app layer) ---
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_ADDRESS_REMOTE=temporal-server:7233
TEMPORAL_NAMESPACE=goodang
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=change-me

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me

# --- ADK ---
GOOGLE_API_KEY=your-gemini-api-key
ADK_MODEL_ID=gemini-2.0-flash
ADK_PROMPT_VERSION=v1.0.0
ADK_AGENT_NAME=goodang-cs

# --- App Layer ---
APP_LAYER_URL=http://127.0.0.1:8000

# --- Observability (Fase 3+) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=goodang-adk
